<!DOCTYPE html>

<html class="bg-[#183642]">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@(ViewBag.Title ?? "Digi-Pin")</title>

    @*this implements the tailwindcss*@
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body ng-app="StudentTaskTrackerModule" ng-controller="StudentTaskTrackerController" class="bg-[#183642] min-h-screen">

    @if (ViewBag.HideHeader != true)
    {
        <header class="flex items-center justify-between shadow-sm px-10 py-4 bg-[#313D5A] rounded-b-lg">
            <span class="text-xl font-bold text-white">Digi-Pin</span>
            <nav class="flex items-center gap-6">
                <a href="/Module/MainPage" class="text-sky-100 hover:text-white transition-colors">Home</a>
                <a href="/Module/AboutPage" class="text-sky-100 hover:text-white transition-colors">About</a>
                <a href="/Module/ContactsPage" class="text-sky-100 hover:text-white transition-colors">Contact</a>
                <a href="/Module/LoginPage" class="text-white bg-sky-800 hover:bg-sky-700 px-4 py-2 rounded transition-colors">Logout</a>
            </nav>
        </header>
    }

    <div>
        @RenderBody()
    </div>

    <footer class="mt-auto border-t border-[#313D5A] bg-[#183642] py-6 px-10 text-sm text-[#FDF0D5]/70">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <span class="font-bold text-[#FDF0D5]">Digi-Pin</span>
                <span>&copy; 2026 All rights reserved.</span>
            </div>
            <nav class="flex items-center gap-6 text-xs">
                <a href="/Module/AboutPage" class="hover:text-white transition-colors">About</a>
                <a href="/Module/ContactsPage" class="hover:text-white transition-colors">Contact</a>
                <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
                <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
            </nav>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/HolyScripts/Module.js"></script>
    <script src="~/Scripts/HolyScripts/Service.js"></script>
    <script src="~/Scripts/HolyScripts/Controller.js"></script>

</body>
</html>