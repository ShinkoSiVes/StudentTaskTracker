@{
    Layout = "~/Views/Shared/_TaskTrackerLayout.cshtml";
}

<div class="flex justify-center items-center min-h-screen py-12">
    <div class="bg-white w-[650px] rounded-2xl shadow-xl overflow-hidden">

        <div class="bg-[#313D5A] px-8 py-8 text-center">
            <h2 class="text-2xl font-bold text-[#FDF0D5]">About StudentTaskTracker</h2>
        </div>

        <div class="p-8 flex flex-col gap-6">

            <p class="text-[#183642] leading-relaxed text-center">
                A simple registration and record management system built with
                ASP.NET MVC and AngularJS.
            </p>

            <div class="flex justify-center gap-2 flex-wrap">
                <span class="bg-[#FDF0D5] text-[#183642] text-sm font-medium px-3 py-1 rounded-full">ASP.NET MVC</span>
                <span class="bg-[#FDF0D5] text-[#183642] text-sm font-medium px-3 py-1 rounded-full">C#</span>
                <span class="bg-[#FDF0D5] text-[#183642] text-sm font-medium px-3 py-1 rounded-full">AngularJS</span>
                <span class="bg-[#FDF0D5] text-[#183642] text-sm font-medium px-3 py-1 rounded-full">Tailwind CSS</span>
            </div>

            <div class="border-t border-gray-100 pt-6 text-center">
                <p class="text-sm text-gray-500">Developed by</p>
                <p class="font-semibold text-[#183642]">[Your Name]</p>
            </div>

        </div>
    </div>
</div>