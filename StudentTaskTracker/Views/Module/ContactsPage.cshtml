@{
    Layout = "~/Views/Shared/_TaskTrackerLayout.cshtml";
}

<div class="flex justify-center items-center min-h-screen py-12">
    <div class="bg-white w-[650px] rounded-2xl shadow-xl overflow-hidden">

        <div class="bg-[#313D5A] px-8 py-8 text-center">
            <h2 class="text-2xl font-bold text-[#FDF0D5]">Contact</h2>
        </div>

        <div class="p-8 flex flex-col gap-6">

            <p class="text-[#183642] leading-relaxed text-center">
                Have a question or feedback about StudentTaskTracker? Get in touch.
            </p>

            <div class="flex flex-col gap-4">
                <div class="flex items-center gap-3 justify-center">
                    <span class="text-sm font-semibold text-[#313D5A] w-20 text-right">Name</span>
                    <span class="text-[#183642]">[Your Name]</span>
                </div>
                <div class="flex items-center gap-3 justify-center">
                    <span class="text-sm font-semibold text-[#313D5A] w-20 text-right">Email</span>
                    <span class="text-[#183642]">[your.email@example.com]</span>
                </div>
                <div class="flex items-center gap-3 justify-center">
                    <span class="text-sm font-semibold text-[#313D5A] w-20 text-right">Phone</span>
                    <span class="text-[#183642]">[Your Number]</span>
                </div>
                <div class="flex items-center gap-3 justify-center">
                    <span class="text-sm font-semibold text-[#313D5A] w-20 text-right">School</span>
                    <span class="text-[#183642]">[Your School/Section]</span>
                </div>
            </div>

        </div>
    </div>
</div>  